PORT=5000
JWT_SECRET=replace_with_secure_jwt_secret
CLIENT_ORIGIN=*

# Supabase Project Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Welcome Email Delivery (choose SMTP e.g. Gmail App Password OR Resend)
# Gmail requires a 16-character Google App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
RESEND_API_KEY=

# SMS OTP Delivery (optional direct fallback if Supabase Phone Auth / Twilio is disabled)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
FAST2SMS_API_KEY=

