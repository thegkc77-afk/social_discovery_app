# Environment Configuration
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# PostgreSQL Database Connection URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/social_discovery?schema=public"

# CORS
CORS_ORIGIN="*"

# Swagger Documentation
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# JWT Authentication
JWT_ACCESS_SECRET="dev_access_secret_super_secure_key_change_in_production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="dev_refresh_secret_super_secure_key_change_in_production"
JWT_REFRESH_EXPIRES_IN="7d"

# OTP Settings
DEV_STATIC_OTP="123456"
OTP_EXPIRATION_MINUTES=5
OTP_MAX_ATTEMPTS=5
