// Prisma Schema for Social Discovery Backend
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum Gender {
  WOMAN
  MAN
  NON_BINARY
  PREFER_NOT_TO_SAY
}

// User account identity
model User {
  id                  String               @id @default(uuid())
  phoneNumber         String               @unique @map("phone_number")
  countryCode         String               @default("+91") @map("country_code")
  isPhoneVerified     Boolean              @default(false) @map("is_phone_verified")
  isActive            Boolean              @default(true) @map("is_active")
  hashedRefreshToken  String?              @map("hashed_refresh_token")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  profile             Profile?
  location            Location?
  photos              Photo[]
  userInterests       UserInterest[]
  preferences         UserPreference?
  verificationRecords VerificationRecord[]
  
  // Likes sent and received
  sentLikes           Like[]               @relation("SentLikes")
  receivedLikes       Like[]               @relation("ReceivedLikes")

  // Matches
  matchesAsUser1      Match[]              @relation("User1Matches")
  matchesAsUser2      Match[]              @relation("User2Matches")

  // Chat memberships and messages
  chatMembers         ChatMember[]
  sentMessages        Message[]            @relation("SentMessages")

  @@map("users")
}

// User Geographic Location
model Location {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  latitude  Float
  longitude Float
  accuracy  Float?
  city      String?
  country   String?
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([latitude, longitude])
  @@map("locations")
}

// Likes between Users
model Like {
  id         String   @id @default(uuid())
  fromUserId String   @map("from_user_id")
  toUserId   String   @map("to_user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  fromUser   User     @relation("SentLikes", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser     User     @relation("ReceivedLikes", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([fromUserId])
  @@index([toUserId])
  @@map("likes")
}

// Mutual Matches
model Match {
  id        String   @id @default(uuid())
  user1Id   String   @map("user1_id")
  user2Id   String   @map("user2_id")
  matchedAt DateTime @default(now()) @map("matched_at")
  isActive  Boolean  @default(true) @map("is_active")

  user1     User     @relation("User1Matches", fields: [user1Id], references: [id], onDelete: Cascade)
  user2     User     @relation("User2Matches", fields: [user2Id], references: [id], onDelete: Cascade)

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
  @@map("matches")
}

// One-Time Passwords for Phone Authentication
model OtpRecord {
  id          String   @id @default(uuid())
  phoneNumber String   @map("phone_number")
  otpHash     String   @map("otp_hash")
  attempts    Int      @default(0)
  expiresAt   DateTime @map("expires_at")
  isUsed      Boolean  @default(false) @map("is_used")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([phoneNumber])
  @@map("otp_records")
}

// User Profile Details
model Profile {
  id                 String             @id @default(uuid())
  userId             String             @unique @map("user_id")
  name               String
  username           String?            @unique
  birthdate          DateTime?
  age                Int?
  gender             String?
  bio                String?            @db.Text
  locationName       String?            @map("location_name")
  online             Boolean            @default(false)
  isAvailable        Boolean            @default(true) @map("is_available")
  intent             String?
  avatarUrl          String?            @map("avatar_url")
  coverPhotoUrl      String?            @map("cover_photo_url")
  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  likesCount         Int                @default(0) @map("likes_count")
  commentsCount      Int                @default(0) @map("comments_count")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([username])
  @@index([verificationStatus])
  @@map("profiles")
}

// User Verification Submissions & Liveness Logs
model VerificationRecord {
  id          String             @id @default(uuid())
  userId      String             @map("user_id")
  selfieUrl   String             @map("selfie_url")
  status      VerificationStatus @default(PENDING)
  confidence  Float?
  notes       String?
  submittedAt DateTime           @default(now()) @map("submitted_at")
  reviewedAt  DateTime?          @map("reviewed_at")

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("verification_records")
}

// User Gallery Photos
model Photo {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  url       String
  order     Int      @default(0)
  isMain    Boolean  @default(false) @map("is_main")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("photos")
}

// Global Interest Catalog
model Interest {
  id            String         @id @default(uuid())
  name          String         @unique
  category      String?
  icon          String?
  createdAt     DateTime       @default(now()) @map("created_at")

  userInterests UserInterest[]

  @@map("interests")
}

// User Selected Interests (Join Table)
model UserInterest {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  interestId String   @map("interest_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@unique([userId, interestId])
  @@index([userId])
  @@index([interestId])
  @@map("user_interests")
}

// User Discovery Preferences
model UserPreference {
  id                   String   @id @default(uuid())
  userId               String   @unique @map("user_id")
  minAge               Int      @default(18) @map("min_age")
  maxAge               Int      @default(99) @map("max_age")
  maxDistanceKm        Int      @default(50) @map("max_distance_km")
  preferredGenders     String[] @default([]) @map("preferred_genders")
  preferredIntents     String[] @default([]) @map("preferred_intents")
  notificationsEnabled Boolean  @default(true) @map("notifications_enabled")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// Chat Thread (Direct 1-on-1 or Group)
model Chat {
  id        String       @id @default(uuid())
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  members   ChatMember[]
  messages  Message[]

  @@map("chats")
}

// Chat Member (Participation & Read Status)
model ChatMember {
  id         String    @id @default(uuid())
  chatId     String    @map("chat_id")
  userId     String    @map("user_id")
  isMuted    Boolean   @default(false) @map("is_muted")
  lastReadAt DateTime  @default(now()) @map("last_read_at")
  joinedAt   DateTime  @default(now()) @map("joined_at")

  chat       Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@index([chatId])
  @@index([userId])
  @@map("chat_members")
}

// Chat Message with optional Meetup Invite payload
model Message {
  id            String    @id @default(uuid())
  chatId        String    @map("chat_id")
  senderId      String    @map("sender_id")
  text          String    @db.Text
  isInvite      Boolean   @default(false) @map("is_invite")
  inviteDetails Json?     @map("invite_details")
  readAt        DateTime? @map("read_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  chat          Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender        User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
  @@index([senderId])
  @@map("messages")
}

// Health check model
model HealthCheck {
  id        String   @id @default(uuid())
  status    String   @default("ok")
  checkedAt DateTime @default(now()) @map("checked_at")

  @@map("health_checks")
}

